{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/sdk",
  "version": "1.14.21",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun ./script/build.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./v2": {
      "import": "./src/v2/index.ts",
      "default": "./src/v2/index.ts"
    },
    "./v2/client": {
      "import": "./src/v2/client.ts",
      "default": "./src/v2/client.ts"
    },
    "./v2/gen/client": {
      "import": "./src/v2/gen/client/index.ts",
      "default": "./src/v2/gen/client/index.ts"
    },
    "./v2/server": {
      "import": "./src/v2/server.ts",
      "default": "./src/v2/server.ts"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "22.0.2",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.13.9",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "cross-spawn": "7.0.6"
  }
}